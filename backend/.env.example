# Neon (or any Postgres) connection string — used for both local dev and
# production, since Neon's free tier has no local-setup cost.
DATABASE_URL="postgresql://user:password@ep-xxxx.aws.neon.tech/dbname?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Matches the "Server URL secret" set on your Vapi assistant — Vapi echoes this
# back in the X-Vapi-Secret header on every webhook call.
VOICE_WEBHOOK_SECRET="change-me-to-another-long-random-string"
